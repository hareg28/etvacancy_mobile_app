{
  "name": "etvacancy-monorepo",
  "private": true,
  "workspaces": [
    "etvacancy-mobile",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "npm run start --workspace=etvacancy-mobile",
    "dev:web": "npm run web --workspace=etvacancy-mobile",
    "build": "npm run build --workspace=etvacancy-mobile",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
